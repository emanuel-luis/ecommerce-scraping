# Copy to .env to override defaults. Every variable is optional and none is a secret.
# Where the raw, processed and warehouse files live (gitignored).
# ECOMMERCE_DATA_DIR=data
# Sent with every request; default: ecommerce-scraping/<version> (+https://github.com/emanuel-luis/ecommerce-scraping)
# ECOMMERCE_USER_AGENT=
# Seconds between two requests to the same store.
# ECOMMERCE_DOWNLOAD_DELAY_S=3
# Product pages per store when --limit is not given.
# ECOMMERCE_DEFAULT_LIMIT=20
# JSON map that replaces a store's base URL (used by the offline end-to-end test).
# ECOMMERCE_STORE_BASE_URLS={"levi": "http://127.0.0.1:8000"}
# ECOMMERCE_LOG_LEVEL=INFO
